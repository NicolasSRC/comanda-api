# ---------------------------------------------------------------------------
# Comanda API - variables de entorno
# Copia este archivo a .env y ajusta los valores.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=3000

# PostgreSQL
DATABASE_URL=postgresql://comanda:comanda@localhost:5432/comanda?schema=public

# JWT
JWT_ACCESS_SECRET=cambia-este-secreto-por-uno-aleatorio-de-64-caracteres
JWT_ACCESS_TTL_SECONDS=900

# Refresh tokens opacos (se guardan hasheados en la base de datos)
REFRESH_TOKEN_TTL_DAYS=30

# Recuperación de contraseña
PASSWORD_RESET_TTL_MINUTES=30

# CORS: lista separada por comas. Usa * solo en desarrollo.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Rate limiting (peticiones por minuto)
THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=120

# Seed del restaurante demo
SEED_ADMIN_EMAIL=admin@demo.com
SEED_ADMIN_PASSWORD=Admin123!
SEED_SUPERADMIN_EMAIL=superadmin@comanda.app
SEED_SUPERADMIN_PASSWORD=Superadmin123!
